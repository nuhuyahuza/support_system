APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production (behind Cloudflare/HTTPS): APP_URL=https://support.clequa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPPORT_BRAND_NAME=Support
SUPPORT_OTP_ENABLED=true
SUPPORT_OTP_DRIVER=log
SUPPORT_AI_ENABLED=false
SUPPORT_AI_PROVIDER=openai
SUPPORT_AI_TRIGGER_MODE=both
SUPPORT_AI_REPLY_TIMEOUT=90
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_MODEL=gpt-4o-mini
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

SUPPORT_TEAM_NAME="Support Team"

# -----------------------------------------------------------------------------
# Reverb (realtime)
# Browser Echo bakes VITE_* at `npm run build` — always rebuild after changing these.
# Chat UI polls ~2.5s when WebSockets are unavailable (common on cPanel without WSS proxy).
# Use ONE block only. Do not leave duplicates (last key wins and confuses deploys).
# -----------------------------------------------------------------------------

# --- Local ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=support
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Production (support.clequa.com) — replace the Local block above with this ---
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=clequa-support
# REVERB_APP_KEY=local-reverb-key
# REVERB_APP_SECRET=local-reverb-secret
# REVERB_HOST=support.clequa.com
# REVERB_PORT=8080
# REVERB_SCHEME=https
# If WSS is reverse-proxied on 443 instead of exposing :8080:
# REVERB_PORT=443

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Production checklist (support.clequa.com):
# 1. Set the Production block values in .env (one REVERB_APP_ID, SCHEME=https, public HOST).
# 2. cd ~/public_html/support.clequa.com/support_system && npm run build
# 3. Start/restart Reverb:
#    pkill -f 'artisan reverb:start' || true
#    mkdir -p storage/logs
#    nohup /opt/cpanel/ea-php84/root/usr/bin/php artisan reverb:start --host=0.0.0.0 --port=8080 >> storage/logs/reverb.log 2>&1 &
# 4. Cron watchdog (every minute), no flock:
#    pgrep -f 'artisan reverb:start' >/dev/null || (cd /home/cleqgnbs/public_html/support.clequa.com/support_system && mkdir -p storage/logs && nohup /opt/cpanel/ea-php84/root/usr/bin/php artisan reverb:start --host=0.0.0.0 --port=8080 >> storage/logs/reverb.log 2>&1 &)
# 5. Hard-refresh the browser; console must show wss://support.clequa.com:8080 (not localhost).
# 6. If :8080 is blocked, polling still keeps chat live until WSS is proxied.
