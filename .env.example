APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production (behind Cloudflare/HTTPS): APP_URL=https://support.clequa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPPORT_BRAND_NAME=Support
SUPPORT_OTP_ENABLED=true
SUPPORT_OTP_DRIVER=log
SUPPORT_AI_ENABLED=false
SUPPORT_AI_PROVIDER=openai
SUPPORT_AI_TRIGGER_MODE=both
SUPPORT_AI_REPLY_TIMEOUT=90
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_MODEL=gpt-4o-mini
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

BROADCAST_CONNECTION=reverb
SUPPORT_TEAM_NAME="Support Team"

# Reverb (realtime). Browser Echo uses VITE_* values baked in at `npm run build`.
# Local:
REVERB_APP_ID=support
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Production (public hostname the browser can reach — not localhost):
# REVERB_HOST=support.clequa.com
# REVERB_PORT=8080
# REVERB_SCHEME=https
# If WSS is reverse-proxied on 443: REVERB_PORT=443
#
# After changing these on the server, rebuild frontend assets so Echo is not stuck on localhost:
#   npm run build
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Chat UI polls every ~2.5s when Echo/WebSocket is unavailable (typical on cPanel without WSS proxy).
